# Normalize line endings; let git detect text vs binary automatically.
* text=auto

# Explicit text types (LF in the repo)
*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
# Text data files — LF (the reference carries this rule too; several are read
# with a plain `\n` split).
*.txt   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.bash  text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.cc    text eol=lf
*.m     text eol=lf
*.swift text eol=lf
*.zig   text eol=lf
*.nix   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.blp   text eol=lf
*.glsl  text eol=lf
*.frag  text eol=lf
*.metal text eol=lf
*.po    text eol=lf
*.pot   text eol=lf
CMakeLists.txt  text eol=lf
*.cmake text eol=lf
Makefile        text eol=lf

# Windows resource files: preserve bytes as-is. `* text=auto` above would
# otherwise let git normalize their line endings, and native Windows resource
# tooling (rc.exe / the manifest reader) is picky about that. Matches the
# reference tree's treatment of dist/windows/*.
*.rc        -text
*.manifest  -text

# VT corpus / golden fixtures are byte-exact: treat as binary so git never
# rewrites them (escape sequences, control bytes must round-trip exactly).
*.vt        binary
*.golden    binary
*.bin       binary

# Fuzz / differential corpus SEEDS carry no extension (`02-crlf`,
# `19-single-byte`, `id_000000,time_0,...`), so none of the extension rules
# above can reach them and the `* text=auto` at the top of this file decides
# instead. That is not hypothetical: it silently rewrote
# `.port/phase-0/corpora/cvt/parser-initial/02-crlf` — a seed whose ENTIRE
# PURPOSE is to feed CRLF through the parser — from `line1\r\nline2` to
# `line1\nline2` at `git add` time. `git status` stayed clean and the working
# tree kept its CRLF (the clean/smudge filter round-trips), so the damage was
# invisible locally and existed only for anyone who cloned. Path rules, not
# extension rules, are the only thing that can guard an extensionless corpus.
#
# PORTS the reference's `test/fuzz-libghostty/.gitattributes`, which marks
# `corpus/parser-initial/** binary` for exactly this reason.
.port/phase-0/corpora/cvt/**                    binary
.port/phase-0/harness/fixtures/**               binary
# Compiled terminfo databases — reference-generated binary goldens, extensionless
# by convention (`ghostty.compiled`). Named for the same reason as the seeds.
.port/phase-0/corpora/terminfo/compiled/**      binary

# Byte-exact fixtures a test compares with `include_bytes!`, and templates a
# generator copies into non-Windows artifacts: kept LF on EVERY checkout. Under
# `* text=auto` a Windows checkout (core.eol=native) turned them CRLF, and the
# golden and Linux-resource tests failed on the Windows lane (task W-2, measured
# on Windows 11). `-text` for the goldens (no conversion either way, like the
# `.golden` rule), `eol=lf` for the templates.
crates/rustty-extra/testdata/**                 -text
# The reference exe's captured output (task W-4): compared byte for byte by
# `.port/tools/windows/exe-differential.ps1 -Mode check` on the Windows leg.
.port/tools/windows/golden/**                   -text
.port/tools/windows/ghostty-exe-at-pin.patch    -text
dist/linux/**                                   text eol=lf

# Generated/large binaries
*.a         binary
*.so        binary
*.dylib     binary
*.wasm      binary
*.png       binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.bdf       binary

# Linguist: keep vendored third-party sources and generated files out of the
# repository's language statistics and collapsed by default in diffs. Without
# these, the ~54 MB of C vendored under crates-sys/*/vendor counts as rustty's
# own code and every review renders it in full.
# `-text` as well as `linguist-vendored`: these are third-party sources whose
# bytes should match upstream exactly. Without it, `* text=auto` rewrote the
# line endings of 15 upstream-CRLF FreeType MSVC project files under
# `freetype-sys/vendor/builds/`. Nothing builds them, so it was drift rather
# than breakage — but a vendored tree that git is free to reformat is not a
# faithful copy of what was vendored.
crates-sys/*/vendor/**              linguist-vendored -text
crates/rustty-vaxis/ucd/**          linguist-vendored
crates/rustty-vt/src/res/**         linguist-vendored
crates/rustty-extra/themes/**       linguist-vendored
include/rustty.h                    linguist-generated=true
include/rustty-apprt.h              linguist-generated=true
crates/rustty-font/src/nerd_font_attributes.rs  linguist-generated=true

# Dev-process internals excluded from `git archive` source tarballs
# (cargo run -p xtask -- dist). These are the port harness/plans/specs, not
# part of the shipped product source.
.port export-ignore
docs/superpowers export-ignore
