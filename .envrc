# If we are a computer with nix-shell available, then use that to setup
# the build environment with exactly what we need.
if has nix; then
  # PORT NOTE: reference defect (R13, UD345). The reference watches
  # `nix/wraptest.nix`, which does not exist; the derivation the dev shell uses
  # is `nix/pkgs/wraptest.nix`, so an edit to it never reloaded the shell.
  # Watch the real path.
  watch_file nix/{devShell,package}.nix nix/pkgs/wraptest.nix
  use flake
fi

source_env_if_exists .envrc.local
