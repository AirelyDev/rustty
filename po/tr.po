#: crates/rustty-apprt/assets/ui/1.5/window.blp:229
msgid "New Tab"
msgstr "Yeni Sekme"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:342
#: crates/rustty-apprt/assets/ui/1.5/window.blp:234
msgid "Close Tab"
msgstr "Sekmeyi Kapat"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:349
msgid "Window"
msgstr "Pencere"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:352
#: crates/rustty-apprt/assets/ui/1.5/window.blp:212
msgid "New Window"
msgstr "Yeni Pencere"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:357
#: crates/rustty-apprt/assets/ui/1.5/window.blp:217
msgid "Close Window"
msgstr "Pencereyi Kapat"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:365
msgid "Config"
msgstr "Yapılandırma"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:368
#: crates/rustty-apprt/assets/ui/1.5/window.blp:295
msgid "Open Configuration"
msgstr "Yapılandırmayı Aç"

#: crates/rustty-apprt/assets/ui/1.3/debug-warning.blp:6
msgid "⚠️ You're running a debug build of Rustty! Performance will be degraded."
msgstr ""
"⚠️ Rustty’nin hata ayıklama amaçlı yapılmış bir sürümünü kullanıyorsunuz! "
"Başarım normale göre daha düşük olacaktır."

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:12
#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:269
#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:273
msgid "Authorize Clipboard Access"
msgstr "Pano Erişimine İzin Ver"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:17
msgid "Deny"
msgstr "Reddet"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:18
msgid "Allow"
msgstr "İzin Ver"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:92
