msgid "Find…"
msgstr "Tìm kiếm…"

#: crates/rustty-apprt/assets/ui/1.2/search-overlay.blp:64
msgid "Previous Match"
msgstr "Kết quả trước"

#: crates/rustty-apprt/assets/ui/1.2/search-overlay.blp:74
