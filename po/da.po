msgstr "Kommandoen lykkedes"

#: crates/rustty-apprt/src/gtk/class/surface.rs:1183
#: crates/rustty-apprt/src/gtk/class/surface_child_exited.rs:113
msgid "Command Failed"
msgstr "Kommandoen fejlede"

#: crates/rustty-apprt/src/gtk/class/title_dialog.rs:227
msgid "Change Terminal Title"
msgstr "Skift terminaltitlen"

#: crates/rustty-apprt/src/gtk/class/title_dialog.rs:228
msgid "Change Tab Title"
msgstr "Skift fanetitel"

#: crates/rustty-apprt/src/gtk/class/title_dialog.rs:229
msgid "Change Window Title"
msgstr "Skift vinduestitel"

#: crates/rustty-apprt/src/gtk/class/window.rs:1153
msgid "Reloaded the configuration"
msgstr "Konfigurationen blev genindlæst"

#: crates/rustty-apprt/src/gtk/class/window.rs:1830
msgid "Copied to clipboard"
msgstr "Kopieret til udklipsholder"

#: crates/rustty-apprt/src/gtk/class/window.rs:1832
msgid "Cleared clipboard"
msgstr "Udklipsholderen blev ryddet"

#: crates/rustty-apprt/src/gtk/class/window.rs:1972
msgid "Rustty Developers"
msgstr "Rustty udviklerne"

#: crates/rustty-input/src/command.rs:149
msgid "Reset Terminal"
msgstr "Nulstil terminal"

#: crates/rustty-input/src/command.rs:150
msgid "Reset the terminal to a clean state."
msgstr "Nulstil terminalen fuldstændigt."

#: crates/rustty-input/src/command.rs:155
msgid "Copy to Clipboard"
msgstr "Kopiér til udklipsholder"

#: crates/rustty-input/src/command.rs:156
msgid ""
"Copy the selected text to the clipboard in both plain and styled formats."
msgstr ""
"Kopiér den valgte tekst i både almindelig og stiliseret format til udklipsholderen."

#: crates/rustty-input/src/command.rs:159
msgid "Copy Selection as Plain Text to Clipboard"
msgstr "Kopiér valg som almindelig tekst til udklipsholderen"

#: crates/rustty-input/src/command.rs:160
msgid "Copy the selected text as plain text to the clipboard."
msgstr "Kopiér den valgte tekst som almindelig tekst til udklipsholderen."

#: crates/rustty-input/src/command.rs:163
msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "Kopiér valg som ANSI-sekvenser til udklipsholderen"

#: crates/rustty-input/src/command.rs:164
msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr "Kopiér det valgte tekst som ANSI escape-sekvenser til udklipsholderen."

#: crates/rustty-input/src/command.rs:167
msgid "Copy Selection as HTML to Clipboard"
msgstr "Kopiér valg som HTML til udklipsholderen"

#: crates/rustty-input/src/command.rs:168
msgid "Copy the selected text as HTML to the clipboard."
msgstr "Kopiér det valgte tekst som HTML til udklipsholderen."

#: crates/rustty-input/src/command.rs:173
msgid "Copy URL to Clipboard"
msgstr "Kopiér URL til udklipsholder"

#: crates/rustty-input/src/command.rs:174
msgid "Copy the URL under the cursor to the clipboard."
msgstr "Kopiér URL'en under musen til udklipsholderen."

#: crates/rustty-input/src/command.rs:179
msgid "Copy Terminal Title to Clipboard"
msgstr "Kopiér terminaltitel til udklipsholder"

#: crates/rustty-input/src/command.rs:180
msgid ""
"Copy the terminal title to the clipboard. If the terminal title is not set "
"this has no effect."
msgstr ""
"Kopiér terminaltitlen til udklipsholderen. Hvis ingen terminaltitel er "
"angivet, vil dette have ingen effekt."

#: crates/rustty-input/src/command.rs:185
msgid "Paste from Clipboard"
msgstr "Sæt ind fra udklipsholder"

#: crates/rustty-input/src/command.rs:186
msgid "Paste the contents of the main clipboard."
msgstr "Indsæt indholdet fra den primære udklipsholder."

#: crates/rustty-input/src/command.rs:191
msgid "Paste from Selection"
msgstr "Sæt ind fra markering"

#: crates/rustty-input/src/command.rs:192
msgid "Paste the contents of the selection clipboard."
msgstr "Indsæt indholdet fra udklipsholderen for markeringer."

#: crates/rustty-input/src/command.rs:197
msgid "Start Search"
msgstr "Start søgning"

#: crates/rustty-input/src/command.rs:198
msgid "Start a search if one isn't already active."
msgstr "Start en søgning, hvis en ikke allerede er aktiv."

#: crates/rustty-input/src/command.rs:203
msgid "Search Selection"
msgstr "Søg i markering"

#: crates/rustty-input/src/command.rs:204
msgid "Start a search for the current text selection."
msgstr "Start en søgning i den aktuelle tekstmarkering."

#: crates/rustty-input/src/command.rs:209
msgid "End Search"
msgstr "Afslut søgning"

#: crates/rustty-input/src/command.rs:210
msgid "End the current search if any and hide any GUI elements."
msgstr "Afslut den nuværende søgning hvis den findes, og skjul eventuelle GUI-elementer."

#: crates/rustty-input/src/command.rs:215
msgid "Next Search Result"
msgstr "Næste søgeresultat"

#: crates/rustty-input/src/command.rs:216
msgid "Navigate to the next search result, if any."
msgstr "Navigér til det næste søgeresultat, hvis det findes."

#: crates/rustty-input/src/command.rs:219
msgid "Previous Search Result"
msgstr "Forrige søgeresultat"

#: crates/rustty-input/src/command.rs:220
msgid "Navigate to the previous search result, if any."
msgstr "Navigér til det forrige søgeresultat, hvis det findes."

#: crates/rustty-input/src/command.rs:225
msgid "Increase Font Size"
msgstr "Øg skriftstørrelsen"

#: crates/rustty-input/src/command.rs:226
msgid "Increase the font size by 1 point."
msgstr "Øg skriftstørrelsen med 1 punkt."

#: crates/rustty-input/src/command.rs:231
msgid "Decrease Font Size"
msgstr "Formindsk skriftstørrelse"

#: crates/rustty-input/src/command.rs:232
msgid "Decrease the font size by 1 point."
msgstr "Formindsk skriftstørrelsen med 1 punkt."

#: crates/rustty-input/src/command.rs:237
msgid "Reset Font Size"
msgstr "Nulstil skriftstørrelse"

#: crates/rustty-input/src/command.rs:238
msgid "Reset the font size to the default."
msgstr "Nulstil skriftstørrelsen til standardindstillingen."

#: crates/rustty-input/src/command.rs:243
msgid "Clear Screen"
msgstr "Ryd skærm"

#: crates/rustty-input/src/command.rs:244
msgid "Clear the screen and scrollback."
msgstr "Ryd skærmen og rul tilbage."

#: crates/rustty-input/src/command.rs:249
msgid "Select All"
msgstr "Vælg alt"

#: crates/rustty-input/src/command.rs:250
msgid "Select all text on the screen."
msgstr "Markér al tekst på skærmen."

#: crates/rustty-input/src/command.rs:255
msgid "Scroll to Top"
msgstr "Rul til toppen"

#: crates/rustty-input/src/command.rs:256
msgid "Scroll to the top of the screen."
msgstr "Rul til toppen af skærmen."

#: crates/rustty-input/src/command.rs:261
msgid "Scroll to Bottom"
msgstr "Rul til bunden"

#: crates/rustty-input/src/command.rs:262
msgid "Scroll to the bottom of the screen."
msgstr "Rul ned til bunden af skærmen."

#: crates/rustty-input/src/command.rs:267
msgid "Scroll to Selection"
msgstr "Rul til markering"

#: crates/rustty-input/src/command.rs:268
msgid "Scroll to the selected text."
msgstr "Rul hen til den markerede tekst."

#: crates/rustty-input/src/command.rs:273
msgid "Scroll Page Up"
msgstr "Rul side op"

