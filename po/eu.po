msgid "Next Search Result"
msgstr "Hurrengo bilaketa-emaitza"

#: crates/rustty-input/src/command.rs:216
msgid "Navigate to the next search result, if any."
msgstr "Joan hurrengo bilaketa emaitzera, baldin badago."

#: crates/rustty-input/src/command.rs:219
msgid "Previous Search Result"
msgstr "Aurreko bilaketa-emaitza"

#: crates/rustty-input/src/command.rs:220
msgid "Navigate to the previous search result, if any."
msgstr "Joan aurreko bilaketa emaitzera, baldin badago."

