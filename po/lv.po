#: crates/rustty-apprt/assets/ui/1.5/window.blp:307
msgid "About Rustty"
msgstr "Par Rustty"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:312
msgid "Quit"
msgstr "Iziet"

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:270
msgid ""
"An application is attempting to write to the clipboard. The current "
"clipboard contents are shown below."
msgstr ""
"Lietotne mēģina rakstīt starpliktuvē. Zemāk ir redzams pašreizējais "
"starpliktuves saturs."

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:274
msgid ""
"An application is attempting to read from the clipboard. The current "
"clipboard contents are shown below."
msgstr ""
"Lietotne mēģina lasīt no starpliktuves. Zemāk ir redzams pašreizējais "
"starpliktuves saturs."

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:277
msgid "Warning: Potentially Unsafe Paste"
msgstr "Brīdinājums: potenciāli nedroša ielīmēšana"

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:278
msgid ""
"Pasting this text into the terminal may be dangerous as it looks like some "
"commands may be executed."
msgstr ""
"Šī teksta ielīmēšana terminālī var būt bīstama, jo izskatās, ka var tikt "
"izpildītas komandas."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:59
msgid "Quit Rustty?"
msgstr "Iziet no Rustty?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:60
msgid "Close Tab?"
msgstr "Aizvērt cilni?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:61
msgid "Close Window?"
msgstr "Aizvērt logu?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:62
msgid "Close Split?"
msgstr "Aizvērt sadalījumu?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:71
msgid "All terminal sessions will be terminated."
msgstr "Visas termināļa sesijas tiks pārtrauktas."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:72
msgid "All terminal sessions in this tab will be terminated."
msgstr "Visas termināļa sesijas šajā cilnē tiks pārtrauktas."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:73
msgid "All terminal sessions in this window will be terminated."
msgstr "Visas termināļa sesijas šajā logā tiks pārtrauktas."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:75
msgid "The currently running process in this split will be terminated."
msgstr "Pašlaik palaistais process šajā sadalījumā tiks pārtraukts."

