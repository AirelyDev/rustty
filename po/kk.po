msgid "Reload configuration to show this prompt again"
msgstr "Бұл сұрауды қайта көрсету үшін конфигурацияны қайта жүктеңіз"

#: crates/rustty-apprt/assets/ui/1.2/close-confirmation-dialog.blp:7
