msgstr "Запомніць выбар для гэтага падзелу"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:93
msgid "Reload configuration to show this prompt again"
msgstr "Перазагрузіць канфігурацыю, каб паказаць гэты запыт зноў"

#: crates/rustty-apprt/assets/ui/1.5/command-palette.blp:17
msgid "Execute a command…"
msgstr "Выканаць каманду…"

#: crates/rustty-apprt/assets/ui/1.5/inspector-window.blp:5
msgid "Rustty: Terminal Inspector"
msgstr "Rustty: інспектар тэрмінала"

#: crates/rustty-apprt/assets/ui/1.5/title-dialog.blp:5
msgid "Leave blank to restore the default title."
msgstr "Пакіньце пустым, каб аднавіць назву па змаўчанні."

#: crates/rustty-apprt/assets/ui/1.5/title-dialog.blp:9
