#: crates/rustty-apprt/assets/ui/1.3/debug-warning.blp:6
msgid "⚠️ You're running a debug build of Rustty! Performance will be degraded."
msgstr ""
"⚠️ Вы запускаеце адладачную зборку Rustty! Прадукцыйнасць будзе зніжана."

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:12
#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:269
#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:273
msgid "Authorize Clipboard Access"
msgstr "Дазволіць доступ да буфера абмену"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:17
msgid "Deny"
msgstr "Адхіліць"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:18
msgid "Allow"
msgstr "Дазволіць"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:92
