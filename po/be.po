#: crates/rustty-apprt/assets/ui/1.5/window.blp:57
#: crates/rustty-apprt/assets/ui/1.5/window.blp:107
#: crates/rustty-apprt/assets/ui/1.5/window.blp:229
msgid "New Tab"
msgstr "Новая ўкладка"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:342
#: crates/rustty-apprt/assets/ui/1.5/window.blp:234
msgid "Close Tab"
msgstr "Закрыць укладку"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:349
msgid "Window"
msgstr "Акно"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:352
#: crates/rustty-apprt/assets/ui/1.5/window.blp:212
msgid "New Window"
