#: dist/linux/rustty_nautilus.py:53
msgid "Open in Rustty"
msgstr "In Rustty öffnen"

#: crates/rustty-apprt/assets/ui/1.2/close-confirmation-dialog.blp:7
#: crates/rustty-apprt/assets/ui/1.5/title-dialog.blp:8
msgid "Cancel"
msgstr "Abbrechen"

