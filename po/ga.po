#: dist/linux/rustty_nautilus.py:53
msgid "Open in Rustty"
msgstr "Oscail i nRustty"

#: crates/rustty-apprt/assets/ui/1.2/close-confirmation-dialog.blp:7
#: crates/rustty-apprt/assets/ui/1.5/title-dialog.blp:8
msgid "Cancel"
msgstr "Cealaigh"

#: crates/rustty-apprt/assets/ui/1.2/close-confirmation-dialog.blp:8
#: crates/rustty-apprt/assets/ui/1.2/search-overlay.blp:85
#: crates/rustty-apprt/assets/ui/1.3/surface-child-exited.blp:17
msgid "Close"
msgstr "Dún"

#: crates/rustty-apprt/assets/ui/1.2/config-errors-dialog.blp:6
msgid "Configuration Errors"
msgstr "Earráidí cumraíochta"

#: crates/rustty-apprt/assets/ui/1.2/config-errors-dialog.blp:7
msgid ""
"One or more configuration errors were found. Please review the errors below, "
"and either reload your configuration or ignore these errors."
msgstr ""
"Fuarthas earráid chumraíochta amháin nó níos mó. Athbhreithnigh na hearráidí "
"thíos, agus athlódáil do chumraíocht nó déan neamhaird de na hearráidí seo."

#: crates/rustty-apprt/assets/ui/1.2/config-errors-dialog.blp:10
msgid "Ignore"
msgstr "Déan neamhaird de"

#: crates/rustty-apprt/assets/ui/1.2/config-errors-dialog.blp:11
#: crates/rustty-apprt/assets/ui/1.2/surface.blp:373
#: crates/rustty-apprt/assets/ui/1.5/window.blp:300
msgid "Reload Configuration"
msgstr "Athlódáil cumraíocht"

#: crates/rustty-apprt/assets/ui/1.2/search-overlay.blp:29
msgid "Find…"
msgstr "Cuardaigh…"

#: crates/rustty-apprt/assets/ui/1.2/search-overlay.blp:64
msgid "Previous Match"
msgstr "An toradh roimhe seo"

#: crates/rustty-apprt/assets/ui/1.2/search-overlay.blp:74
msgid "Next Match"
msgstr "An chéad toradh eile"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:6
msgid "Oh, no."
msgstr "Ó, fadbh."

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:7
msgid "Unable to acquire an OpenGL context for rendering."
msgstr "Ní féidir comhthéacs OpenGL a fháil le haghaidh rindreála."

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:99
msgid ""
"This terminal is in read-only mode. You can still view, select, and scroll "
"through the content, but no input events will be sent to the running "
"application."
msgstr ""
"Tá an teirminéal seo i mód inléite amháin. Is féidir leat fós féachaint, "
"roghnú agus scroláil tríd an ábhar, ach ní seolfar aon teagmhais ionchuir "
"chuig an bhfeidhmchlár atá ag rith."

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:109
msgid "Read-only"
msgstr "Inléite amháin"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:262
#: crates/rustty-apprt/assets/ui/1.5/window.blp:200
msgid "Copy"
msgstr "Cóipeáil"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:267
#: crates/rustty-apprt/assets/ui/1.5/window.blp:205
msgid "Paste"
msgstr "Greamaigh"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:272
msgid "Notify on Next Command Finish"
msgstr "Seol fógra nuair a chríochnaíonn an chéad ordú eile"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:279
#: crates/rustty-apprt/assets/ui/1.5/window.blp:273
msgid "Clear"
msgstr "Glan"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:284
#: crates/rustty-apprt/assets/ui/1.5/window.blp:278
msgid "Reset"
msgstr "Athshocraigh"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:291
#: crates/rustty-apprt/assets/ui/1.5/window.blp:242
msgid "Split"
