msgstr "Scoilt suas"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:305
#: crates/rustty-apprt/assets/ui/1.5/window.blp:182
#: crates/rustty-apprt/assets/ui/1.5/window.blp:255
msgid "Split Down"
msgstr "Scoilt síos"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:311
#: crates/rustty-apprt/assets/ui/1.5/window.blp:187
#: crates/rustty-apprt/assets/ui/1.5/window.blp:260
msgid "Split Left"
msgstr "Scoilt ar chlé"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:317
#: crates/rustty-apprt/assets/ui/1.5/window.blp:192
#: crates/rustty-apprt/assets/ui/1.5/window.blp:265
msgid "Split Right"
msgstr "Scoilt ar dheis"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:323
msgid "Close Split"
msgstr ""

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:329
