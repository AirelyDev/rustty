#: crates/rustty-apprt/assets/ui/1.5/window.blp:57
#: crates/rustty-apprt/assets/ui/1.5/window.blp:107
#: crates/rustty-apprt/assets/ui/1.5/window.blp:229
msgid "New Tab"
msgstr "Táb nua"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:342
#: crates/rustty-apprt/assets/ui/1.5/window.blp:234
msgid "Close Tab"
msgstr "Dún táb"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:349
msgid "Window"
msgstr "Fuinneog"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:352
#: crates/rustty-apprt/assets/ui/1.5/window.blp:212
msgid "New Window"
msgstr "Fuinneog nua"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:357
#: crates/rustty-apprt/assets/ui/1.5/window.blp:217
msgid "Close Window"
msgstr "Dún fuinneog"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:365
msgid "Config"
msgstr "Cumraíocht"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:368
#: crates/rustty-apprt/assets/ui/1.5/window.blp:295
msgid "Open Configuration"
msgstr "Oscail cumraíocht"

#: crates/rustty-apprt/assets/ui/1.3/debug-warning.blp:6
msgid "⚠️ You're running a debug build of Rustty! Performance will be degraded."
msgstr ""
"⚠️ Tá leagan dífhabhtaithe de Rustty á rith agat! Laghdófar an fheidhmíocht."

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:12
#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:269
#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:273
msgid "Authorize Clipboard Access"
msgstr "Údarú rochtain ar an ngearrthaisce"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:17
msgid "Deny"
msgstr "Diúltaigh"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:18
msgid "Allow"
msgstr "Ceadaigh"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:92
msgid "Remember choice for this split"
msgstr "Sábháil an rogha don scoilt seo"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:93
msgid "Reload configuration to show this prompt again"
msgstr "Athlódáil an chumraíocht chun an teachtaireacht seo a thaispeáint arís"

#: crates/rustty-apprt/assets/ui/1.5/command-palette.blp:17
msgid "Execute a command…"
msgstr "Rith ordú…"

#: crates/rustty-apprt/assets/ui/1.5/inspector-window.blp:5
msgid "Rustty: Terminal Inspector"
msgstr "Rustty: Cigire teirminéil"

#: crates/rustty-apprt/assets/ui/1.5/title-dialog.blp:5
msgid "Leave blank to restore the default title."
msgstr "Fág bán chun an teideal réamhshocraithe a athbhunú."

#: crates/rustty-apprt/assets/ui/1.5/title-dialog.blp:9
msgid "OK"
msgstr "Ceart go leor"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:58
#: crates/rustty-apprt/assets/ui/1.5/window.blp:108
msgid "New Split"
msgstr "Scoilt nua"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:68
#: crates/rustty-apprt/assets/ui/1.5/window.blp:126
msgid "View Open Tabs"
msgstr "Féach ar na táib oscailte"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:78
#: crates/rustty-apprt/assets/ui/1.5/window.blp:140
msgid "Main Menu"
msgstr "Príomh-Roghchlár"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:285
msgid "Command Palette"
msgstr "Pailéad ordaithe"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:290
msgid "Terminal Inspector"
msgstr "Cigire teirminéil"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:307
msgid "About Rustty"
msgstr "Maidir le Rustty"

#: crates/rustty-apprt/assets/ui/1.5/window.blp:312
msgid "Quit"
msgstr "Scoir"

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:270
msgid ""
"An application is attempting to write to the clipboard. The current "
"clipboard contents are shown below."
msgstr ""
"Tá feidhmchlár ag iarraidh scríobh chuig an ngearrthaisce. Taispeántar ábhar "
"reatha an ghearrthaisce thíos."

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:274
msgid ""
"An application is attempting to read from the clipboard. The current "
"clipboard contents are shown below."
msgstr ""
"Tá feidhmchlár ag iarraidh léamh ón ngearrthaisce. Taispeántar ábhar reatha "
"an ghearrthaisce thíos."

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:277
msgid "Warning: Potentially Unsafe Paste"
msgstr "Rabhadh: Greamaigh a d'fhéadfadh a bheith neamhshábháilte"

#: crates/rustty-apprt/src/gtk/class/clipboard_confirmation_dialog.rs:278
msgid ""
"Pasting this text into the terminal may be dangerous as it looks like some "
"commands may be executed."
msgstr ""
"D’fhéadfadh sé a bheith contúirteach an téacs seo a ghreamú isteach sa "
"teirminéal, toisc go d'fhéadfadh roinnt orduithe a fhorghníomhú."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:59
msgid "Quit Rustty?"
msgstr "Scoir Rustty?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:60
msgid "Close Tab?"
msgstr "Dún táb?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:61
msgid "Close Window?"
msgstr "Dún fuinneog?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:62
msgid "Close Split?"
msgstr "Dún an scoilt?"

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:71
msgid "All terminal sessions will be terminated."
msgstr "Cuirfear deireadh le gach seisiún teirminéil."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:72
msgid "All terminal sessions in this tab will be terminated."
msgstr "Cuirfear deireadh le gach seisiún teirminéil sa táb seo."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:73
msgid "All terminal sessions in this window will be terminated."
msgstr "Cuirfear deireadh le gach seisiún teirminéil san fhuinneog seo."

#: crates/rustty-apprt/src/gtk/class/close_confirmation_dialog.rs:75
msgid "The currently running process in this split will be terminated."
msgstr ""
"Cuirfear deireadh leis an bpróiseas atá ar siúl faoi láthair sa scoilt seo."

#: crates/rustty-apprt/src/gtk/class/surface.rs:1933
msgid "Command Finished"
msgstr "Ordú críochnaithe"

#: crates/rustty-apprt/src/gtk/class/surface.rs:1934
msgid "Command Succeeded"
msgstr "D’éirigh leis an ordú"

#: crates/rustty-apprt/src/gtk/class/surface.rs:1935
msgid "Command Failed"
msgstr "Theip ar an ordú"

#: crates/rustty-apprt/src/gtk/class/surface_child_exited.rs:154
msgid "Command succeeded"
msgstr "D'éirigh leis an ordú"

#: crates/rustty-apprt/src/gtk/class/surface_child_exited.rs:158
msgid "Command failed"
msgstr "Theip ar an ordú"

#: crates/rustty-apprt/src/gtk/class/title_dialog.rs:43
msgid "Change Terminal Title"
msgstr "Athraigh teideal teirminéil"

#: crates/rustty-apprt/src/gtk/class/title_dialog.rs:44
msgid "Change Tab Title"
msgstr "Athraigh teideal an táb"

#: crates/rustty-apprt/src/gtk/class/window.rs:1019
msgid "Cleared clipboard"
msgstr "Gearrthaisce glanta"

#: crates/rustty-apprt/src/gtk/class/window.rs:1021
msgid "Copied to clipboard"
msgstr "Cóipeáilte chuig an ghearrthaisce"

#: crates/rustty-apprt/src/gtk/class/window.rs:1744
msgid "Reloaded the configuration"
msgstr "Tá an chumraíocht athlódáilte"

