#: crates/rustty-apprt/assets/ui/1.2/surface.blp:317
#: crates/rustty-apprt/assets/ui/1.5/window.blp:192
#: crates/rustty-apprt/assets/ui/1.5/window.blp:265
msgid "Split Right"
msgstr "Подели надесно"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:323
msgid "Close Split"
msgstr ""

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:329
