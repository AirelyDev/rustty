#: crates/rustty-apprt/assets/ui/1.5/window.blp:177
#: crates/rustty-apprt/assets/ui/1.5/window.blp:250
msgid "Split Up"
msgstr "Подели нагоре"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:305
#: crates/rustty-apprt/assets/ui/1.5/window.blp:182
#: crates/rustty-apprt/assets/ui/1.5/window.blp:255
msgid "Split Down"
