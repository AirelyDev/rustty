#: crates/rustty-apprt/assets/ui/1.2/surface.blp:332
#: crates/rustty-apprt/assets/ui/1.5/window.blp:224
#: crates/rustty-apprt/assets/ui/1.5/window.blp:320
msgid "Change Tab Title…"
msgstr "Промени наслов на јазиче…"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:337
#: crates/rustty-apprt/assets/ui/1.5/window.blp:57
#: crates/rustty-apprt/assets/ui/1.5/window.blp:107
#: crates/rustty-apprt/assets/ui/1.5/window.blp:229
msgid "New Tab"
msgstr "Ново јазиче"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:342
#: crates/rustty-apprt/assets/ui/1.5/window.blp:234
msgid "Close Tab"
msgstr "Затвори јазиче"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:349
msgid "Window"
msgstr "Прозор"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:352
#: crates/rustty-apprt/assets/ui/1.5/window.blp:212
msgid "New Window"
msgstr "Нов прозор"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:357
#: crates/rustty-apprt/assets/ui/1.5/window.blp:217
msgid "Close Window"
msgstr "Затвори прозор"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:365
