msgstr "Разрешаване на достъп до клипборда"

#: crates/rustty-apprt/assets/ui/1.0/clipboard-confirmation-dialog.blp:17
#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:17
msgid "Deny"
msgstr "Откажи"

#: crates/rustty-apprt/assets/ui/1.0/clipboard-confirmation-dialog.blp:18
#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:18
msgid "Allow"
msgstr "Позволи"

#: crates/rustty-apprt/assets/ui/1.4/clipboard-confirmation-dialog.blp:92
