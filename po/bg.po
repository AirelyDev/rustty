#: crates/rustty-apprt/assets/ui/1.2/surface.blp:411 crates/rustty-apprt/assets/ui/1.5/window.blp:220
#: crates/rustty-input/src/command.rs:421
msgid "New Window"
msgstr "Нов прозорец"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:416 crates/rustty-apprt/assets/ui/1.5/window.blp:225
#: crates/rustty-input/src/command.rs:630
