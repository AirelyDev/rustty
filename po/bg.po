#: crates/rustty-input/src/command.rs:672
msgid "Toggle Mouse Reporting"
msgstr "Превключване на предаването на събития от мишката"

#: crates/rustty-input/src/command.rs:673
msgid "Toggle whether mouse events are reported to terminal applications."
msgstr ""
"Превключване дали събитията от мишката да се предават на приложенията в "
"терминала."

#: crates/rustty-input/src/command.rs:678
msgid "Toggle Background Opacity"
msgstr "Превключване на прозрачността на фона"

#: crates/rustty-input/src/command.rs:679
msgid "Toggle the background opacity of a window that started transparent."
msgstr ""
"Превключване между прозрачен и непрозрачен фон за прозорец, стартиран с "
"прозрачен фон."

#: crates/rustty-input/src/command.rs:684
msgid "Check for Updates"
msgstr "Проверка за обновления"

#: crates/rustty-input/src/command.rs:685
msgid "Check for updates to the application."
msgstr "Проверка за обновления на приложението."

#: crates/rustty-input/src/command.rs:690
msgid "Undo"
msgstr "Отмяна"

#: crates/rustty-input/src/command.rs:691
msgid "Undo the last action."
msgstr "Отмяна на последното действие."

#: crates/rustty-input/src/command.rs:696
msgid "Redo"
msgstr "Повтаряне"

#: crates/rustty-input/src/command.rs:697
msgid "Redo the last undone action."
msgstr "Повтаряне на последното отменено действие."

#: crates/rustty-input/src/command.rs:703
msgid "Quit the application."
msgstr "Излизане от приложението."

#: crates/rustty-input/src/command.rs:708
msgid "Rustty"
msgstr "Rustty"

#: crates/rustty-input/src/command.rs:709
msgid "Put a little Rustty in your terminal."
msgstr "Добавете малко Rustty в терминала си."
