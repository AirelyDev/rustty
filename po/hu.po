msgstr "Új fül"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:342
#: crates/rustty-apprt/assets/ui/1.5/window.blp:234
msgid "Close Tab"
msgstr "Fül bezárása"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:349
msgid "Window"
msgstr "Ablak"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:352
#: crates/rustty-apprt/assets/ui/1.5/window.blp:212
msgid "New Window"
msgstr "Új ablak"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:357
#: crates/rustty-apprt/assets/ui/1.5/window.blp:217
msgid "Close Window"
msgstr "Ablak bezárása"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:365
msgid "Config"
msgstr "Konfiguráció"

#: crates/rustty-apprt/assets/ui/1.2/surface.blp:368
#: crates/rustty-apprt/assets/ui/1.5/window.blp:295
