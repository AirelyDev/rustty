// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#define RT_MANIFEST 1
RT_MANIFEST 24 "rustty.manifest"

#define ID_ICON_RUSTTY 1
ID_ICON_RUSTTY ICON "rustty.ico"

// PORT NOTE: reference defect (R13), UD331. The reference's ghostty.rc uses
// VS_VERSION_INFO without defining it (no winver.h include), so the resource
// compiler names the version resource by the STRING "VS_VERSION_INFO" and
// Windows, which looks up id 1, shows no version information. Defined here as
// the file defines its other two ids (RT_MANIFEST, ID_ICON_RUSTTY).
#define VS_VERSION_INFO 1
VS_VERSION_INFO VERSIONINFO
//FILEVERSION     VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_COMMIT_HEIGHT
//PRODUCTVERSION  VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_COMMIT_HEIGHT
//FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
//FILEFLAGS               VER_DBG
//FILEOS                  VOS_NT
//FILETYPE                VFT_APP
//FILESUBTYPE             VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
        //VALUE "CompanyName",        "???"
        //VALUE "FileDescription",    "???"
        //VALUE "FileVersion",        VERSION
        //VALUE "LegalCopyright",     "(C) 2024 ???"
        VALUE "OriginalFilename", "rustty.exe"
        VALUE "ProductName",        "Rustty"
        //VALUE "ProductVersion",     VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409,1200
    END
END
