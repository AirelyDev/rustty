# Doxyfile 1.13.2

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "librustty"
PROJECT_LOGO           = images/gnome/64.png
INPUT                  = include/rustty
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.h
EXAMPLE_PATH           = example
EXAMPLE_RECURSIVE      = YES
EXAMPLE_PATTERNS       = *
FULL_PATH_NAMES        = NO
STRIP_FROM_INC_PATH    = include
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------

# Enable preprocessing to handle #ifdef guards
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __wasm__

#---------------------------------------------------------------------------
# C API Optimization
#---------------------------------------------------------------------------

# Optimize output for C API documentation
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
HIDE_SCOPE_NAMES       = YES

# Clean path names
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

# Hide undocumented and internal APIs
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
EXTRACT_ALL            = NO
INTERNAL_DOCS          = NO
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = NO

#---------------------------------------------------------------------------
# HTML Output
#---------------------------------------------------------------------------

OUTPUT_DIRECTORY       = doc
GENERATE_HTML          = YES
HTML_OUTPUT            = librustty
HTML_EXTRA_STYLESHEET  = dist/doxygen/rustty.css
HTML_EXTRA_FILES       = dist/doxygen/favicon.png \
                         dist/doxygen/mobile-nav.js \
                         crates/rustty-vt-c/types.schema.json
HTML_COLORSTYLE        = DARK
HTML_CODE_FOLDING      = NO
# NOT SET, deliberately — and this differs from the reference on purpose.
#
# The reference carries `HTML_TIMESTAMP = NO` for reproducibility (without it,
# every page embeds its build time). That tag was RENAMED to `TIMESTAMP` in
# doxygen 1.14, so on a current doxygen the reference's spelling produces
# "Tag 'HTML_TIMESTAMP' ... has become obsolete", while the new spelling
# produces an unknown-tag warning on the doxygen Ubuntu still ships (1.9.8).
# There is no spelling that is clean on both.
#
# It does not need to be set either way: NO is the default in every version
# from 1.8.16 onward, verified against the doxygen in use here — a generated
# page contains no "Generated on ..." line. `G-DOXYGEN`
# (.port/tools/gates/check_doxygen.sh) is what actually holds the docs to a
# warning-free build, which is the guarantee this line was reaching for.
HTML_HEADER            = dist/doxygen/header.html
LAYOUT_FILE            = DoxygenLayout.xml
GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES
ALPHABETICAL_INDEX     = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

#---------------------------------------------------------------------------
# Graphs and Diagrams
#---------------------------------------------------------------------------

HAVE_DOT               = NO

#---------------------------------------------------------------------------
# Man Output
#---------------------------------------------------------------------------

GENERATE_MAN           = YES
MAN_OUTPUT             = man
MAN_EXTENSION          = .3
MAN_LINKS              = YES

#---------------------------------------------------------------------------
# Other Output
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO
