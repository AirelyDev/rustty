# Doxyfile 1.13.2

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "librustty"
PROJECT_LOGO           = images/gnome/64.png
INPUT                  = include/rustty
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.h
EXAMPLE_PATH           = example
EXAMPLE_RECURSIVE      = YES
EXAMPLE_PATTERNS       = *
FULL_PATH_NAMES        = NO
STRIP_FROM_INC_PATH    = include
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------

# Enable preprocessing to handle #ifdef guards
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __wasm__

#---------------------------------------------------------------------------
# C API Optimization
#---------------------------------------------------------------------------

# Optimize output for C API documentation
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
HIDE_SCOPE_NAMES       = YES

# Clean path names
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

# Hide undocumented and internal APIs
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
EXTRACT_ALL            = NO
INTERNAL_DOCS          = NO
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = NO

#---------------------------------------------------------------------------
# HTML Output
#---------------------------------------------------------------------------

OUTPUT_DIRECTORY       = doc
GENERATE_HTML          = YES
HTML_OUTPUT            = librustty
HTML_EXTRA_STYLESHEET  = dist/doxygen/rustty.css
HTML_EXTRA_FILES       = dist/doxygen/favicon.png \
                         dist/doxygen/mobile-nav.js \
                         crates/rustty-vt-c/types.schema.json
HTML_COLORSTYLE        = DARK
HTML_CODE_FOLDING      = NO
# Reproducibility: without this every generated page embeds its build time, so
# two runs over identical sources produce different bytes. Carried over from the
# reference Doxyfile, where it had been dropped in the port.
HTML_TIMESTAMP         = NO
HTML_HEADER            = dist/doxygen/header.html
LAYOUT_FILE            = DoxygenLayout.xml
GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES
ALPHABETICAL_INDEX     = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

#---------------------------------------------------------------------------
# Graphs and Diagrams
#---------------------------------------------------------------------------

HAVE_DOT               = NO

#---------------------------------------------------------------------------
# Man Output
#---------------------------------------------------------------------------

GENERATE_MAN           = YES
MAN_OUTPUT             = man
MAN_EXTENSION          = .3
MAN_LINKS              = YES

#---------------------------------------------------------------------------
# Other Output
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO
