+test "grid four-byte cells run full normalization" {
+    const testing = std.testing;
+    var page = try TerminalPage.init(.{
+        .cols = 3,
+        .rows = 1,
+        .styles = 8,
+    });
+    defer page.deinit();
+    var style_remap = try StyleRemap.init(testing.allocator);
+    defer style_remap.deinit(testing.allocator);
