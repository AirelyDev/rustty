+        switch (wrapper.kind) {
+            .terminal => |*t| t.format(adapter.writer()) catch break :format_,
+        }
+        adapter.writer().flush() catch break :format_;
+        return .success;
+    }
+
+    if (adapter.invalid_write) return .limit_exceeded;
+    if (adapter.callback_failed) return .io_error;
+    return .io_error;
