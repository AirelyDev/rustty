+            // Scary looking but safe, mapping a byte pointer to the full
+            // vector type (hence align 1).
+            @as(*align(1) V, @ptrCast(dst_bytes[i * 3 ..][0..16])).* = out;
+        }
+    }
+
+    for (src[i..], dst[i..]) |entry, *out| out.* = entry.cval();
+}
