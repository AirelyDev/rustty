+/// Format directly to a synchronous C writer callback.
+pub fn format(
+    formatter_: Formatter,
+    writer: io_c.Writer,
+) callconv(lib.calling_conv) Result {
+    const wrapper = formatter_ orelse return .invalid_value;
+    if (!writer.valid()) return .invalid_value;
