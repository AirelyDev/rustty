+    const palette_mask_offset = Header.len + tabstop_len + 256 * 3;
+    try testing.expectEqual(@as(u8, 0x01), bytes[palette_mask_offset]);
+    try testing.expectEqual(
+        @as(u8, 0x80),
+        bytes[palette_mask_offset + 31],
