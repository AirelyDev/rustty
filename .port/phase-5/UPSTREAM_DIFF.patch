+            .mime = .init(@as([]const u8, "text/plain")),
+            .data = .init(@as([]const u8, "Ghostty")),
+        }};
+        request.reply(request, &.{
+            .size = @sizeOf(ClipboardReadReply),
+            .result = .success,
+            .contents = &contents,
+            .contents_len = contents.len,
+            .available = null,
+            .available_len = 0,
+            .remember = false,
