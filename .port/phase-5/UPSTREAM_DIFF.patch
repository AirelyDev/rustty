+    // The kitten requests the data and concludes with a copy.
+    _ = try h.command("t=r:x=1", null);
+    try h.expectOutput(
+        "\x1b]72;t=r:x=1:m=0;aGVsbG8gZnJvbSBnaG9zdHR5Cg==\x1b\\" ++
+            "\x1b]72;t=r:x=1\x1b\\",
