+        len: usize = 0,
+        reads: [2]usize = @splat(0),
+        fail: bool = false,
+
+        fn init(entries: []const struct { []const u8, []const u8 }) Contents {
+            var self: Contents = .{};
+            for (entries) |entry| {
+                self.mimes[self.len] = .init(entry[0]);
+                self.data[self.len] = entry[1];
+                self.len += 1;
+            }
+            return self;
+        }
