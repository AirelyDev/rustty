+/// A paste of clipboard contents into the terminal. Sized struct.
+///
+/// C: GhosttyPaste
+pub const Request = extern struct {
+    size: usize = @sizeOf(Request),
+    location: clipboard.Location,
+    source: Source,
+    mimes: ?[*]const lib.String,
+    mimes_len: usize,
+    reader: io.MimeReader,
+    allow_unsafe: bool,
+};
