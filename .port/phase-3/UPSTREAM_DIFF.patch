+        for (framework.headers) |h| writer.print(framework_header_fmt, .{ framework.name, h }) catch unreachable;
+    }
+    for (extra_headers) |h| writer.print(extra_header_fmt, .{h}) catch unreachable;
+    buf[len] = 0;
+    return buf;
