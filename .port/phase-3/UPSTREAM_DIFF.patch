+            // Coretext
+            if (options.coretext) {
+                try flag_builder.appendSlice(b.allocator, &.{"-DHAVE_CORETEXT=1"});
+                try flag_builder.appendSlice(b.allocator, &.{"-fblocks"});
+            }
