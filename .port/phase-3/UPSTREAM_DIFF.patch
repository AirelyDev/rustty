+
+    // Release our I/O instance
+    self.io_impl.deinit();
+
+    if (self.gpa) |*value| {
+        // We want to ensure that we deinit the GPA because this is
+        // the point at which it will output if there were safety violations.
+        _ = value.deinit();
+    }
