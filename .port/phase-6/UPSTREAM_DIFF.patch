+    const state = &self.notify_state;
+
+    // A screen switch makes all previously notified per-screen state
+    // stale, so reset it to force recalculations and notifications.
+    if (state.key != s.active_key) {
+        state.key = s.active_key;
+        state.total = null;
+        state.selected = null;
+    }
