+    try testing.expectEqual(@as(size.CellCountInt, 0), sel.start.x);
+    try testing.expectEqual(@as(size.CellCountInt, 3), sel.end.x);
+    try testing.expect(search.next() == null);
+    try testing.expect(!try search.feed());
+}
