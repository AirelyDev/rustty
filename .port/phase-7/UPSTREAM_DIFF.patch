+    // rows in place (eraseRowBounded) rather than moving the viewport.
+    s.nextSlice("\x1b[?1049h");
+    s.nextSlice("0\r\n1\r\n2\r\n3\r\n4");
+    s.nextSlice("\x1b[2;5r\x1b[5;2H");
